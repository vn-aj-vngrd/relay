{
  "name": "relay-pickleball",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "auth:reset-limits": "node --env-file=.env.local --experimental-strip-types scripts/reset-auth-rate-limits.ts",
    "backup:database": "./scripts/backup-database.sh",
    "build": "next build",
    "check": "ultracite check",
    "check:changed": "node scripts/fast-check.mjs --quality-only",
    "check:fast": "node scripts/fast-check.mjs --quality-only",
    "check:fix": "ultracite fix",
    "check:full": "pnpm check && pnpm typecheck && pnpm test && pnpm build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "dev": "next dev --turbopack -p 3002",
    "prepare": "node scripts/install-git-hooks.mjs",
    "release:check": "./scripts/release-gate.sh",
    "release:verify-production": "./scripts/verify-production-release.sh",
    "start": "next start -p 3002",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:production": "E2E_BASE_URL=https://relay.vanajvanguardia.tech playwright test",
    "test:related": "node scripts/fast-check.mjs --tests-only",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "venues:import-cebu": "node --env-file=.env.local --experimental-strip-types scripts/import-cebu-venues.ts",
    "venues:import-ph": "node --env-file=.env.local --experimental-strip-types scripts/import-ph-courts.ts",
    "test:reliability": "node scripts/reliability.mjs",
    "test:e2e:reliability": "playwright test --config=playwright.reliability.config.ts"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.104",
    "@marsidev/react-turnstile": "^1.6.1",
    "@openrouter/ai-sdk-provider": "^3.0.0",
    "@phosphor-icons/react": "^2.1.10",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "@tiptap/markdown": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@vercel/analytics": "^2.0.1",
    "ai": "^7.0.101",
    "drizzle-orm": "^0.45.2",
    "lenis": "^1.3.26",
    "maplibre-gl": "^6.9.0",
    "next": "^16.3.4",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "web-push": "^3.6.7",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "2.5.13",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.5.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "@vitest/coverage-v8": "4.1.10",
    "conventional-changelog-conventionalcommits": "9.3.1",
    "drizzle-kit": "^0.31.10",
    "jsdom": "^30.0.1",
    "lefthook": "2.1.12",
    "semantic-release": "25.0.9",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "ultracite": "7.11.1",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@10.12.1"
}
