# Public application origin. Use the Vercel production URL in production.
NEXT_PUBLIC_APP_URL=http://localhost:3002

# Local setup metadata written by scripts/setup-integrations.sh
SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_REGION=ap-southeast-1

# Supabase Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# Cloudflare Turnstile → Widget settings. The site key is public; the setup-only secret is pushed to Supabase Auth.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# Server only. Never expose this value in client code.
SUPABASE_SECRET_KEY=sb_secret_your-key

# Resend SMTP values consumed by `supabase config push`; keep the API key server-only.
RESEND_API_KEY=re_your-key
SMTP_FROM_EMAIL=relay@vanajvanguardia.tech

# Supabase Connect → Transaction pooler URI. Keep `sslmode=require`.
DATABASE_URL=postgresql://postgres.your-project-ref:password@your-pooler-host:6543/postgres?sslmode=require

# Geoapify project key. Server-only; browser requests go through Relay route handlers.
GEOAPIFY_API_KEY=your-geoapify-api-key
GEOAPIFY_API_URL=https://api.geoapify.com

# Secret bearer token for private deep readiness checks. Generate with `openssl rand -base64 32`.
HEALTHCHECK_SECRET=replace-with-at-least-32-random-characters

# Comma-separated accounts allowed to open the production admin console.
ADMIN_EMAILS=owner@example.com

# Maximum chat photo upload size in bytes. Default: 1 MiB.
CHAT_IMAGE_MAX_BYTES=1048576
