# Public application origin. Use the Vercel production URL in production.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Local setup metadata written by scripts/setup-integrations.sh
SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_REGION=ap-southeast-1

# Supabase Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Server only. Never expose this value in client code.
SUPABASE_SECRET_KEY=sb_secret_your-key

# Supabase Connect → Transaction pooler URI. Keep `sslmode=require`.
DATABASE_URL=postgresql://postgres.your-project-ref:password@your-pooler-host:6543/postgres?sslmode=require
