#!/bin/sh

message_file="$1"
subject=$(head -n 1 "$message_file")
pattern='^(feat|fix|refactor|perf|test|docs|build|ci|chore|style|revert)(\([a-z0-9._/-]+\))?!?: .+'

if printf '%s\n' "$subject" | grep -Eq "$pattern"; then
  exit 0
fi

cat >&2 <<'EOF'
Commit message must use a Conventional Commit prefix.

Examples:
  feat: add install support
  fix(auth): keep the login panel stable
  refactor: simplify session routing
  ci: enforce commit message format

Allowed prefixes: feat, fix, refactor, perf, test, docs, build, ci, chore, style, revert
EOF
exit 1
